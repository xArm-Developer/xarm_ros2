<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="uf850_ros2_control" params="prefix
    velocity_control:='false'
    cartesian_servo_mode:='false'
    ros2_control_plugin:='uf_robot_hardware/UFRobotSystemHardware'
    hw_ns:='xarm' add_gripper:='false' add_bio_gripper:='false'
    robot_ip:='' report_type:='normal' baud_checkset:='true' default_gripper_baud:=2000000
    has_ft_sensor:='true'
    ft_sensor_mode:='0' ft_coord:='0'
    ft_c_axis:='1 0 0 0 1 0'
    ft_f_ref:='8 0 0 0 0 0'
    ft_limits:='0 0 0 0 0 0'
    ft_kp:='0.005 0.005 0.005 0.005 0.005 0.005'
    ft_ki:='0.00005 0.00005 0.00005 0.00005 0.00005 0.00005'
    ft_kd:='0.05 0.05 0.05 0.05 0.05 0.05'
    ft_xe_limit:='200 200 200 0.1 0.1 0.1'
    ft_zero_on_activate:='true'
    home_on_activate:='true' home_pose:='' home_joints:='45 0 0 0 90 0'
    home_speed:=100 home_acc:=1000 home_joint_speed:=20 home_joint_acc:=200
    tcp_speed:=200 tcp_acc:=2000 tcp_radius:=-1 cmd_queue_max:=16
    joint1_lower_limit:=${-2.0*pi}  joint1_upper_limit:=${2.0*pi}
    joint2_lower_limit:=${-2.3038346}  joint2_upper_limit:=${2.3038346}
    joint3_lower_limit:=${-4.2236968}  joint3_upper_limit:=${0.061087}
    joint4_lower_limit:=${-2.0*pi}  joint4_upper_limit:=${2.0*pi}
    joint5_lower_limit:=${-2.1642}  joint5_upper_limit:=${2.1642}
    joint6_lower_limit:=${-2.0*pi}  joint6_upper_limit:=${2.0*pi}">
    <ros2_control name="${prefix}${ros2_control_plugin}" type="system">
      <hardware>
        <plugin>${ros2_control_plugin}</plugin>
        <xacro:if value="${ros2_control_plugin == 'uf_robot_hardware/UFRobotSystemHardware'}">
          <param name="hw_ns">${prefix}${hw_ns}</param>
          <param name="velocity_control">${velocity_control}</param>
          <!-- true: set_servo_cartesian()/XARM_MODE::SERVO streams the tcp target
               directly, no motion queue, no backlog/jitter under continuous streaming.
               Costs the ft gpio (force control needs XARM_MODE::POSE). false (default):
               set_position()/XARM_MODE::POSE, force-control-capable, unchanged. -->
          <param name="cartesian_servo_mode">${cartesian_servo_mode}</param>
          <param name="prefix">P${prefix}</param>
          <param name="robot_ip">R${robot_ip}</param>
          <param name="report_type">${report_type}</param>
          <param name="dof">6</param>
          <param name="baud_checkset">${baud_checkset}</param>
          <param name="default_gripper_baud">${default_gripper_baud}</param>
          <param name="robot_type">uf850</param>
          <param name="add_gripper">${add_gripper}</param>
          <param name="add_bio_gripper">${add_bio_gripper}</param>
          <!-- Onboard force control. has_ft_sensor: false skips every F/T SDK call, for
               hardware with no sensor at all. ft_sensor_mode: 0 off (wrench still readable),
               1 admittance, 2 force control. ft_coord: 0 base frame, 1 tool frame. Vectors
               are 6 space separated values, ordered x y z rx ry rz. -->
          <param name="has_ft_sensor">${has_ft_sensor}</param>
          <param name="ft_sensor_mode">${ft_sensor_mode}</param>
          <param name="ft_coord">${ft_coord}</param>
          <param name="ft_c_axis">${ft_c_axis}</param>
          <param name="ft_f_ref">${ft_f_ref}</param>
          <param name="ft_limits">${ft_limits}</param>
          <param name="ft_kp">${ft_kp}</param>
          <param name="ft_ki">${ft_ki}</param>
          <param name="ft_kd">${ft_kd}</param>
          <param name="ft_xe_limit">${ft_xe_limit}</param>
          <param name="ft_zero_on_activate">${ft_zero_on_activate}</param>
          <!-- Homing runs on activation, before the force loop is armed.
               home_pose is x y z in mm then roll pitch yaw in deg; home_joints is
               joint angles in deg and is only used when home_pose is empty. -->
          <param name="home_on_activate">${home_on_activate}</param>
          <!-- Emitted only when set: an empty <param> makes the ros2_control URDF
               parser warn "text not specified in the ... tag". -->
          <xacro:unless value="${home_pose == ''}">
            <param name="home_pose">${home_pose}</param>
          </xacro:unless>
          <xacro:unless value="${home_joints == ''}">
            <param name="home_joints">${home_joints}</param>
          </xacro:unless>
          <param name="home_speed">${home_speed}</param>
          <param name="home_acc">${home_acc}</param>
          <param name="home_joint_speed">${home_joint_speed}</param>
          <param name="home_joint_acc">${home_joint_acc}</param>
          <!-- set_position() parameters used by write(). tcp_radius < 0 disables
               blending. cmd_queue_max caps how deep the controller command cache may
               get before write() skips a cycle. -->
          <param name="tcp_speed">${tcp_speed}</param>
          <param name="tcp_acc">${tcp_acc}</param>
          <param name="tcp_radius">${tcp_radius}</param>
          <param name="cmd_queue_max">${cmd_queue_max}</param>
        </xacro:if>
        <!-- fake -->
        <!-- <plugin>fake_components/GenericSystem</plugin> -->

        <!-- gazebo -->
        <!-- <plugin>gazebo_ros2_control/GazeboSystem</plugin> -->

        <!-- real xarm -->
        <!-- <plugin>uf_robot_hardware/UFRobotSystemHardware</plugin> -->
      </hardware>
      <joint name="${prefix}joint1">
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
        <!-- <state_interface name="effort"/> -->
      </joint>
      <joint name="${prefix}joint2">
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
        <!-- <state_interface name="effort"/> -->
      </joint>
      <joint name="${prefix}joint3">
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
        <!-- <state_interface name="effort"/> -->
      </joint>
      <joint name="${prefix}joint4">
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
        <!-- <state_interface name="effort"/> -->
      </joint>
      <joint name="${prefix}joint5">
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
        <!-- <state_interface name="effort"/> -->
      </joint>
      <joint name="${prefix}joint6">
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
        <!-- <state_interface name="effort"/> -->
      </joint>
      <!-- Cartesian TCP command and state, SI units (m, rad). Commanded with
           set_position() in POSE or set_servo_cartesian() in SERVO
           (cartesian_servo_mode) rather than per joint. -->
      <gpio name="${prefix}tcp">
        <command_interface name="x"/>
        <command_interface name="y"/>
        <command_interface name="z"/>
        <command_interface name="roll"/>
        <command_interface name="pitch"/>
        <command_interface name="yaw"/>
        <!-- Optional. The set_position() speed for the next motion, mm/s; 0 leaves the
             tcp_speed param above in charge. Nothing reads a speed back, so there is no
             state counterpart. -->
        <command_interface name="speed"/>
        <!-- Optional. 0 asks for POSE, 1 for SERVO, switched at runtime once the arm is
             idle. Leave it NaN and the cartesian_servo_mode param stays in charge. The
             state is the mode the arm reports. -->
        <command_interface name="servo"/>
        <state_interface name="x">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="y">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="z">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="roll">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="pitch">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="yaw">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="servo">
          <param name="initial_value">0.0</param>
        </state_interface>
        <!-- Optional. 1.0 while the arm's controller error code is non-zero, 0.0 while it
             is clear, NaN while the driver is not connected. Meant for the
             safety_controller's trip_interfaces (<prefix>tcp/fault). -->
        <state_interface name="fault">
          <param name="initial_value">0.0</param>
        </state_interface>
      </gpio>

      <!-- Runtime force control. enable toggles the onboard force loop, coord picks
           base (0) or tool (1), c_axis_N marks an axis compliant and f_ref_N is its
           target in N or Nm. Vectors are one interface per element because
           ros2_control command interfaces are scalar doubles. Optional even in POSE
           mode: without this component the loop is still set from the launch params,
           just not adjustable at runtime. Always declared, since the arm can switch to
           servo at runtime, but enabling force control is refused while in SERVO. -->
      <gpio name="${prefix}ft">
        <command_interface name="enable"/>
        <command_interface name="coord"/>
        <command_interface name="c_axis_0"/>
        <command_interface name="c_axis_1"/>
        <command_interface name="c_axis_2"/>
        <command_interface name="c_axis_3"/>
        <command_interface name="c_axis_4"/>
        <command_interface name="c_axis_5"/>
        <command_interface name="f_ref_0"/>
        <command_interface name="f_ref_1"/>
        <command_interface name="f_ref_2"/>
        <command_interface name="f_ref_3"/>
        <command_interface name="f_ref_4"/>
        <command_interface name="f_ref_5"/>
        <state_interface name="enable">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="mode">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="error">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="force_x">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="force_y">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="force_z">
          <param name="initial_value">0.0</param>
        </state_interface>
      </gpio>
      <!-- End effector wrench, N and Nm. These interface names are what
           semantic_components::ForceTorqueSensor expects, so
           force_torque_sensor_broadcaster can claim them directly. -->
      <sensor name="${prefix}ft_sensor">
        <state_interface name="force.x">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="force.y">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="force.z">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="torque.x">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="torque.y">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="torque.z">
          <param name="initial_value">0.0</param>
        </state_interface>
      </sensor>
    </ros2_control>
  </xacro:macro>
</robot>